# ============================================================
#  LeechX — تنظیمات محیطی
#  این فایل را به .env کپی کن و مقادیر را پر کن.
# ============================================================

# ---------- اجباری ----------
BOT_TOKEN=123456:ABC-DEF...
# آیدی عددی مالک (با کاما جدا کن اگر چند نفرند) — همیشه ادمین است
OWNER_IDS=123456789
# ادمین‌های اضافی (با کاما) — از پنل ربات هم قابل اضافه‌شدن است
ADMIN_IDS=
# سقف تعداد ادمین‌های قابل افزودن از پنل (0 = بی‌نهایت)
MAX_ADMINS=20

# ---------- دیتابیس ----------
# پیش‌فرض: SQLite داخل پوشه data
# برای مقیاس بالا (کاربر زیاد) از Postgres استفاده کن:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/leechx
DATABASE_URL=
DATA_DIR=./data

# ---------- لینک مستقیم ----------
# آدرسی که کاربران از بیرون می‌بینند (دامنه یا IP عمومی سرور)
PUBLIC_BASE_URL=http://127.0.0.1:8080
# کلید امضای لینک‌ها؛ خالی بگذار تا خودکار ساخته شود (data/.link_secret)
LINK_SECRET=
# پیش‌فرض ۶ ساعت — از پنل ادمین هم قابل تغییر است
LINK_TTL_HOURS=6

# ---------- وب‌سرور داخلی (لینک مستقیم + health) ----------
HOST=0.0.0.0
PORT=8080

# ---------- محدودیت‌ها ----------
# حداکثر حجم آپلود به تلگرام (مگابایت). با Local Bot API Server تا 2000 مجاز است.
MAX_UPLOAD_MB=2000
# حداکثر حجم فایلی که برای ساخت لینک مستقیم پذیرفته می‌شود
MAX_LINK_FILE_MB=2000
# حداکثر تعداد کار همزمان هر کاربر
PER_USER_CONCURRENCY=1
# تعداد کارگرهای دانلود/آپلود
WORKERS=2
# فاصلهٔ حداقلی بین دو درخواست هر کاربر (ثانیه)
RATE_LIMIT_SECONDS=3
# سهمیهٔ روزانهٔ هر کاربر (0 = بی‌نهایت)
DAILY_QUOTA=0
# حداکثر ارتفاع ویدیو (0 = بی‌نهایت)
MAX_HEIGHT=0

# ---------- شبکه / دانلود ----------
# پروکسی برای دانلود (اختیاری) مثلا: http://127.0.0.1:1080
PROXY=
# کوکی‌ها (اختیاری) — برای یوتیوب/اینستاگرام محدودشده
COOKIES_DIR=./data/cookies
# Local Bot API Server (اختیاری) — برای فایل‌های بالای ۵۰ مگابایت
# TELEGRAM_API_URL=http://localhost:8081/bot
# TELEGRAM_API_FILE_URL=http://localhost:8081/file/bot
TELEGRAM_API_URL=
TELEGRAM_API_FILE_URL=

# ---------- رفتار ----------
DEFAULT_LANG=fa
# فعال‌بودن سایت‌های بزرگسال در دیتابیس سایت‌ها
NSFW_ENABLED=true
LOG_LEVEL=INFO
# پاک‌سازی خودکار پوشهٔ موقت هر چند ثانیه
CLEANUP_INTERVAL_SECONDS=300
